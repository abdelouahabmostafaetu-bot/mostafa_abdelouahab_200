NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_EMAIL=
ICONSCOUT_API_KEY=
ICONSCOUT_CLIENT_ID=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# ---------------------------------------------------------------------------
# AI providers (server-side only — NEVER prefix any of these with NEXT_PUBLIC)
# Add the keys for the providers you want users to be able to choose.
# Only providers that have a key set will actually work; the rest show a
# friendly "not set up" message.
# ---------------------------------------------------------------------------

# Google Gemini (default model)
GEMINI_API_KEY=

# Groq — very fast, free tier
GROQ_API_KEY=

# Cerebras — very fast, free tier
CEREBRAS_API_KEY=

# OpenRouter — one key, many models
OPENROUTER_API_KEY=

# Mistral
MISTRAL_API_KEY=

# NVIDIA NIM (integrate.api.nvidia.com)
NVIDIA_API_KEY=

# OpenAI (paid) — GPT models
OPENAI_API_KEY=

# Anthropic (paid) — Claude models (reserved for future use)
ANTHROPIC_API_KEY=

# Hugging Face (reserved for future use)
HUGGINGFACE_API_KEY=

# Cohere (reserved for future use)
COHERE_API_KEY=
